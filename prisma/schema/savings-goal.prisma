enum SavingsGoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

model SavingsGoal {
  id                   String              @id @default(uuid()) @db.Uuid
  financial_profile_id String              @db.Uuid
  profile              FinancialProfile    @relation(fields: [financial_profile_id], references: [id], onDelete: Cascade)
  user_id              String              @db.Uuid
  user                 User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name                 String
  target_amount        BigInt
  target_date          DateTime?           @db.Date
  note                 String?
  status               SavingsGoalStatus   @default(ACTIVE)
  achieved_at          DateTime?           @db.Timestamptz
  created_at           DateTime            @default(now()) @db.Timestamptz
  updated_at           DateTime            @updatedAt @db.Timestamptz
  allocations          SavingsAllocation[]

  @@index([financial_profile_id, status])
  @@index([user_id])
  @@map("savings_goals")
}
