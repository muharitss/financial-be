enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
  REVERSAL
}

enum TransactionStatus {
  POSTED
  SCHEDULED
  CANCELLED
  REVERSED
}

enum FeeMode {
  SEPARATE
  BUNDLED
}

model Transaction {
  id                    String             @id @default(uuid()) @db.Uuid
  financial_profile_id  String             @db.Uuid
  profile               FinancialProfile   @relation(fields: [financial_profile_id], references: [id], onDelete: Cascade)
  user_id               String             @db.Uuid
  user                  User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  account_id            String             @db.Uuid
  account               Account            @relation("FromAccount", fields: [account_id], references: [id], onDelete: Restrict)
  to_account_id         String?            @db.Uuid
  to_account            Account?           @relation("ToAccount", fields: [to_account_id], references: [id], onDelete: Restrict)
  type                  TransactionType
  amount                BigInt
  date                  DateTime           @db.Date
  status                TransactionStatus  @default(POSTED)
  category_id           String?            @db.Uuid
  category              Category?          @relation(fields: [category_id], references: [id], onDelete: Restrict)
  transfer_group_id     String?            @db.Uuid
  transfer_fee          BigInt             @default(0)
  fee_mode              FeeMode?
  parent_transaction_id String?            @unique @db.Uuid
  parent                Transaction?       @relation("Reversal", fields: [parent_transaction_id], references: [id], onDelete: Restrict)
  reversal              Transaction?       @relation("Reversal")
  reason                String?
  note                  String?
  client_tx_id          String             @db.VarChar(64)
  processed_at          DateTime?          @db.Timestamptz
  job_run_id            String?            @db.Uuid
  cancelled_at          DateTime?          @db.Timestamptz
  created_at            DateTime           @default(now()) @db.Timestamptz
  updated_at            DateTime           @updatedAt @db.Timestamptz

  splits                TransactionSplit[]
  tags                  TransactionTag[]
  audits                TransactionAudit[]

  @@unique([user_id, client_tx_id])
  @@index([user_id, date, created_at])
  @@index([account_id, status])
  @@index([transfer_group_id])
  @@index([parent_transaction_id])
  @@index([financial_profile_id, status, date])
  @@map("transactions")
}
