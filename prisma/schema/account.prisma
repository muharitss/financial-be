enum AccountType {
  CASH
  BANK
  EWALLET
  SAVINGS
  INVESTMENT
  RECEIVABLE
  OTHER
}

model Account {
  id                   String           @id @default(uuid()) @db.Uuid
  financial_profile_id String           @db.Uuid
  profile              FinancialProfile @relation(fields: [financial_profile_id], references: [id], onDelete: Cascade)
  user_id              String           @db.Uuid
  user                 User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name                 String
  type                 AccountType
  provider             String?
  opening_balance      BigInt
  opening_date         DateTime         @db.Date
  balance              BigInt           @default(0)
  allow_negative       Boolean          @default(false)
  archived             Boolean          @default(false)
  archived_at          DateTime?        @db.Timestamptz
  note                 String?
  created_at           DateTime         @default(now()) @db.Timestamptz
  updated_at           DateTime         @updatedAt @db.Timestamptz
  transactions_out     Transaction[]    @relation("FromAccount")
  transactions_in      Transaction[]    @relation("ToAccount")
  savings_allocations  SavingsAllocation[]

  @@unique([financial_profile_id, name])
  @@index([user_id])
  @@index([financial_profile_id, archived])
  @@map("accounts")
}
