model BudgetPeriod {
  id               String           @id @default(uuid()) @db.Uuid
  budget_id        String           @db.Uuid
  budget           Budget           @relation(fields: [budget_id], references: [id], onDelete: Cascade)
  period           String
  base_amount      BigInt
  carryover_amount BigInt           @default(0)
  locked_at        DateTime?        @db.Timestamptz
  created_at       DateTime         @default(now()) @db.Timestamptz
  updated_at       DateTime         @updatedAt @db.Timestamptz
  categories       BudgetCategory[]

  @@unique([budget_id, period])
  @@index([budget_id, period])
  @@map("budget_periods")
}
