enum BudgetType {
  TOTAL
  CATEGORY
}

model Budget {
  id                   String           @id @default(uuid()) @db.Uuid
  financial_profile_id String           @db.Uuid
  profile              FinancialProfile @relation(fields: [financial_profile_id], references: [id], onDelete: Cascade)
  user_id              String           @db.Uuid
  user                 User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type                 BudgetType
  category_id          String?          @db.Uuid
  category             Category?        @relation(fields: [category_id], references: [id], onDelete: Restrict)
  scope_account_ids    String[]         @default([])
  created_at           DateTime         @default(now()) @db.Timestamptz
  updated_at           DateTime         @updatedAt @db.Timestamptz
  periods              BudgetPeriod[]

  @@unique([financial_profile_id, type, category_id])
  @@index([financial_profile_id])
  @@map("budgets")
}
